# Apache / cPanel: ES modules must be served as JavaScript or browsers refuse them.
AddType text/javascript .mjs .js
AddType application/geo+json .geojson
AddType image/svg+xml .svg

# Caching. The page, its script, styles and data always revalidate (ETag / 304), so a deploy
# shows on the next visit instead of a week later. Only the vendored MapLibre modules and images
# cache for a week; they change rarely and the .css / .js / .geojson rule keeps the rest fresh.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|geojson)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(mjs|png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/geo+json image/svg+xml
</IfModule>
